{
  "name": "FamilyHome",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/FamilyHome",
  "remoteUser": "vscode",
    // Commit signing on every start; idempotent, never replaces an existing key
    "postStartCommand": "bash .devcontainer/setup-signing.sh",
  "features": {
    "ghcr.io/devcontainers/features/node:2": { "version": "lts" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Docker für Testcontainers in den Server-Integrationstests
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // Leichtgewichtiger Desktop (noVNC auf Port 6080), um das Avalonia-Desktop-Kopfprojekt anzuzeigen
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [5080, 6080, "radicale:5232"],
  "portsAttributes": {
    "5080": { "label": "FamilyHome.Server" },
    "6080": { "label": "Desktop (noVNC)" },
    "radicale:5232": { "label": "Radicale (CalDAV/CardDAV)" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "AvaloniaTeam.vscode-avalonia",
        "ms-azuretools.vscode-docker",
        "EditorConfig.EditorConfig",
        "anthropic.claude-code",
        // Additional AI workers for work packages (work/); the model connection is configured locally in the extension
        "saoudrizwan.claude-dev",
        "kilocode.kilo-code"
      ],
      "settings": {
        // No telemetry (CLAUDE.md); Cline follows this setting
        "telemetry.telemetryLevel": "off"
      }
    }
  }
}
