# Kopieren nach .env (nie committen) und alle Werte ersetzen. Zufallswerte z. B. mit: openssl rand -base64 48

# Öffentliche Adresse eures Familien-Servers (DNS bzw. DynDNS muss auf euren Anschluss zeigen, Port 443/80 freigegeben)
FAMILYHOME_DOMAIN=familie.example.org
ACME_EMAIL=admin@example.org

POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me

# Offizielles Image und erwartete Signatur-Identität (für update.sh)
FAMILYHOME_REPO=relexx/family-home
FAMILYHOME_IMAGE_NAME=ghcr.io/relexx/familyhome-server
# wird von update.sh gesetzt:
FAMILYHOME_IMAGE=
