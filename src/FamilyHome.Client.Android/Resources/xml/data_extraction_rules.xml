<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <!-- Keine App-Daten in Cloud-Backups oder bei der Geräteübertragung: Daten kommen nach Neuinstallation vom Server -->
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
